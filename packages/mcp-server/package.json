{
  "name": "@afriex/mcp-server",
  "version": "1.1.0",
  "type": "module",
  "description": "MCP server for the Afriex Business API — let AI assistants send and receive cross-border payments",
  "author": "Afriex",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Afri-exchange/afriex-sdk",
    "directory": "packages/mcp-server"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "afriex-mcp": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "watch": "tsc -p tsconfig.json --watch",
    "dev": "tsc -p tsconfig.json && node --watch ./dist/index.js",
    "start": "node ./dist/index.js",
    "start:http": "node ./dist/index.js --http",
    "start:oauth": "node ./dist/index.js --http --oauth",
    "prepublishOnly": "npm run build",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@afriex/sdk": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "better-sqlite3": "^12.11.1",
    "cors": "^2.8.5",
    "express": "^4.21.0",
    "jose": "^6.2.3",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.19.17",
    "pino-pretty": "^13.0.0"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "keywords": [
    "afriex",
    "mcp",
    "model-context-protocol",
    "payments",
    "africa",
    "fintech",
    "send-money",
    "cross-border"
  ]
}
