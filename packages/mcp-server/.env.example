# Copy to .env and fill in real values. Never commit the filled-in .env.

# --- Auth mode ---
AFRIEX_MCP_AUTH_MODE=oauth

# --- OAuth (required when AFRIEX_MCP_AUTH_MODE=oauth) ---
OAUTH_PROVIDER=custom
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OAUTH_ENCRYPTION_KEY= < generate >
# This server's real public URL — not localhost, not the container's internal port.
OAUTH_AUDIENCE= # e.g https://mcp.afriex.com

# --- Optional ---
# Only needed if you want a fallback key for callers that don't send their
# own x-afriex-api-key header. Leave unset for a pure bring-your-own-key deployment.
# AFRIEX_API_KEY=
AFRIEX_ENVIRONMENT=staging
AFRIEX_LOG_LEVEL=info
